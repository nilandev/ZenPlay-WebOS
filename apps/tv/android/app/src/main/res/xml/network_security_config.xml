<?xml version="1.0" encoding="utf-8"?>
<!--
  IPTV providers (Xtream Codes panels, M3U/XMLTV hosts) are added by the
  user at runtime as arbitrary third-party URLs, the large majority of
  which are plain HTTP, not HTTPS — so this can't be a per-domain
  allowlist the way network security config is normally used. Since
  Android 9 (API 28) blocks cleartext (HTTP) traffic by default, without
  this the app cannot reach almost any real-world IPTV provider and every
  screen fails to load with no content, which is the exact symptom this
  file fixes.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
