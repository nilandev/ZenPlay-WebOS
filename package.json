{
  "name": "free-iptv-player",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* build",
    "test": "pnpm -r --filter=./packages/* --filter=./apps/* test",
    "typecheck": "pnpm -r --filter=./packages/* --filter=./apps/* typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "dev:tv": "pnpm --filter @iptv/tv dev"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
